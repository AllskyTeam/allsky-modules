{
    "icon": "fas fa-chart-line",
    "group": "Sky Traffic",
    "title": "Satellites",
    "type": "line",
    "main": true,
    "table": "allsky_skytraffic",
    "yAxis": [
        {
            "title": {
                "text": "Sunlit satellites up"
            },
            "min": 0,
            "allowDecimals": false
        },
        {
            "title": {
                "text": "Trails in the image"
            },
            "min": 0,
            "allowDecimals": false,
            "opposite": true
        }
    ],
    "series": [
        {
            "name": "Sunlit satellites up",
            "yAxis": 0,
            "variable": "AS_SKYTRAFFIC_SATS"
        },
        {
            "name": "Trails seen",
            "yAxis": 1,
            "type": "column",
            "variable": "AS_SKYTRAFFIC_SEEN|true"
        }
    ]
}
